---
import { siteTags } from "../../../data/tags";
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import WidgetLayout from "../common/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout
	name={i18n(I18nKey.tags)}
	id="tags"
	class={className}
	style={style}
>
	<ul class="static-tag-list" aria-label="站点标签">
		{
			siteTags.map((tag) => <li class="static-tag">{tag}</li>)
		}
	</ul>
</WidgetLayout>

<style>
	.static-tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.static-tag {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		padding: 0.25rem 0.75rem;
		border-radius: 0.5rem;
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		font-size: 0.875rem;
		line-height: 1.25rem;
		cursor: default;
		user-select: none;
	}

	:global(.dark) .static-tag {
		color: rgb(255 255 255 / 0.88);
	}
</style>
